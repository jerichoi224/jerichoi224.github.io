---
import Base from '../../layouts/Base.astro'
import { apps } from '../../data/apps'
---

<Base title="Apps" description="Small self-contained tools and pages by Daniel Choi.">
  <main class="post-list">
    {
      apps.map((app) => (
        <a class="post-item" href={app.href}>
          <div class="date">{app.year}</div>
          <div class="meta">
            <div>{app.name}</div>
            {app.description && <div class="excerpt">{app.description}</div>}
          </div>
        </a>
      ))
    }
  </main>
</Base>
